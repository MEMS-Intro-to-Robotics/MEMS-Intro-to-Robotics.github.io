# Copy this file to ubuntu_desktop_setup.env and fill in the values for your lab.

LAB_DESKTOP_USER=labuser
DUKE_FALCON_DEB=/path/to/falcon-sensor_<version>_amd64.deb
DUKE_FALCON_CCID=<customer-id-with-checksum>

# Optional CrowdStrike proxy settings.
# DUKE_FALCON_PROXY_HOST=proxy.example.duke.edu
# DUKE_FALCON_PROXY_PORT=8080

# Set to 1 only if you are preparing a master image to be cloned.
DUKE_FALCON_MASTER_IMAGE=0

# Set to 1 only when you intentionally need to skip Duke CrowdStrike.
SKIP_DUKE_CROWDSTRIKE=0
